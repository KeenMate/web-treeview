{
  "name": "@keenmate/web-treeview",
  "version": "1.0.0",
  "description": "Framework-agnostic web component wrapper for @keenmate/svelte-treeview. Works with React, Vue, Angular, or vanilla JavaScript.",
  "type": "module",
  "main": "./dist/web-treeview.umd.js",
  "module": "./dist/web-treeview.js",
  "types": "./dist/web-treeview.d.ts",
  "exports": {
    ".": {
      "types": "./dist/web-treeview.d.ts",
      "import": "./dist/web-treeview.js",
      "require": "./dist/web-treeview.umd.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite --port 21111",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "treeview",
    "svelte",
    "framework-agnostic",
    "hierarchical",
    "ltree",
    "drag-drop",
    "search",
    "flexsearch",
    "react",
    "vue", 
    "angular",
    "vanilla-js",
    "shadow-dom",
    "typescript"
  ],
  "author": "KeenMate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeenMate/web-treeview.git"
  },
  "homepage": "https://github.com/KeenMate/web-treeview#readme",
  "bugs": {
    "url": "https://github.com/KeenMate/web-treeview/issues"
  },
  "dependencies": {
    "@keenmate/svelte-treeview": "^4.0.0",
    "flexsearch": "^0.8.212",
    "svelte": "^5.38.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^24.3.1",
    "sass": "^1.92.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
