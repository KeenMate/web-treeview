{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": false,
    "noImplicitAny": false,

    /* Declaration */
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    // Original UMD distributions kept for reference only — the code imports the
    // `-esm.js` variants via index.js/prefix.js. The UMD IIFE form can't be
    // represented in declaration emit (TS9005 on the wrapper's private `Logger`).
    "src/vendor/loglevel/loglevel.js",
    "src/vendor/loglevel/loglevel-plugin-prefix.js"
  ]
}
