{
  "$schema": "https://raw.githubusercontent.com/keenmate/schemas/main/component-variables.schema.json",
  "component": "@keenmate/web-treeview",
  "prefix": "tv",
  "baseVariables": [
    { "name": "base-rem", "required": false, "usage": "Base sizing unit (default: 10px)" },
    { "name": "base-accent-color", "required": true, "usage": "Selected nodes, context menu accents, scroll highlight, empty zone" },
    { "name": "base-accent-color-hover", "required": false, "usage": "Accent hover state" },
    { "name": "base-accent-color-light", "required": false, "usage": "Selected node background" },
    { "name": "base-text-color-1", "required": true, "usage": "Primary text (node labels, context menu items)" },
    { "name": "base-text-color-3", "required": false, "usage": "Secondary text (node paths, toggle icons, divider labels)" },
    { "name": "base-text-color-on-accent", "required": false, "usage": "Text on accent backgrounds (drag ghost)" },
    { "name": "base-main-bg", "required": true, "usage": "Tree background, context menu background" },
    { "name": "base-elevated-bg", "required": false, "usage": "Elevated surface background (debug stats badges)" },
    { "name": "base-hover-bg", "required": false, "usage": "Node hover background, context menu item hover" },
    { "name": "base-active-bg", "required": false, "usage": "Node active/pressed background" },
    { "name": "base-border-color", "required": true, "usage": "Context menu border, dividers, debug info border, spinner track" },
    { "name": "base-success-color", "required": false, "usage": "Valid drop indicator, dragover highlight" },
    { "name": "base-danger-color", "required": false, "usage": "Invalid drop indicator, context menu danger items" },
    { "name": "base-font-family", "required": false, "usage": "All text in component" },
    { "name": "base-font-size-xs", "required": false, "usage": "Toggle icons, node paths, debug info (multiplier)" },
    { "name": "base-font-size-sm", "required": false, "usage": "Node labels, context menu items (multiplier)" },
    { "name": "base-font-size-base", "required": false, "usage": "Base text size (multiplier)" },
    { "name": "base-font-weight-medium", "required": false, "usage": "Node label weight" },
    { "name": "base-font-weight-semibold", "required": false, "usage": "Debug info headers, drop zone labels" },
    { "name": "base-border-radius-sm", "required": false, "usage": "Selected node borders (multiplier)" },
    { "name": "base-border-radius-md", "required": false, "usage": "Medium radius (multiplier)" },
    { "name": "base-border-radius-lg", "required": false, "usage": "Context menu, empty zone radius (multiplier)" }
