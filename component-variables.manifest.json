    { "name": "tv-dragged-opacity", "category": "dnd", "usage": "Opacity of dragged node (0.5)" },

    { "name": "tv-context-menu-bg", "category": "context-menu", "usage": "Context menu background" },
    { "name": "tv-context-menu-bg-hover", "category": "context-menu", "usage": "Context menu item hover background" },
    { "name": "tv-context-menu-text-color", "category": "context-menu", "usage": "Context menu text color" },
    { "name": "tv-context-menu-border", "category": "context-menu", "usage": "Context menu border" },
    { "name": "tv-context-menu-border-radius", "category": "context-menu", "usage": "Context menu border radius" },
    { "name": "tv-context-menu-shadow", "category": "context-menu", "usage": "Context menu box shadow" },
    { "name": "tv-context-menu-min-width", "category": "context-menu", "usage": "Context menu minimum width (~150px)" },
    { "name": "tv-context-menu-padding", "category": "context-menu", "usage": "Context menu padding" },
    { "name": "tv-context-menu-font-size", "category": "context-menu", "usage": "Context menu font size" },
    { "name": "tv-context-menu-item-padding", "category": "context-menu", "usage": "Context menu item padding" },
    { "name": "tv-context-menu-item-gap", "category": "context-menu", "usage": "Gap between icon, label, shortcut" },
    { "name": "tv-context-menu-icon-width", "category": "context-menu", "usage": "Icon column width in context menu" },
    { "name": "tv-context-menu-icon-font-size", "category": "context-menu", "usage": "Icon font size in context menu" },
    { "name": "tv-context-menu-arrow-font-size", "category": "context-menu", "usage": "Submenu arrow font size" },
    { "name": "tv-context-menu-danger-color", "category": "context-menu", "usage": "Danger item text color" },
    { "name": "tv-context-menu-danger-bg-hover", "category": "context-menu", "usage": "Danger item hover background" },
    { "name": "tv-context-menu-divider-color", "category": "context-menu", "usage": "Divider line color" },
    { "name": "tv-context-menu-divider-margin", "category": "context-menu", "usage": "Divider margin" },
    { "name": "tv-context-menu-disabled-opacity", "category": "context-menu", "usage": "Disabled item opacity" },

    { "name": "tv-spinner-size", "category": "loading", "usage": "Loading spinner size (32px)" },
    { "name": "tv-spinner-track", "category": "loading", "usage": "Spinner track color" },
    { "name": "tv-spinner-color", "category": "loading", "usage": "Spinner accent color" },
    { "name": "tv-loading-bg", "category": "loading", "usage": "Loading overlay background" },

    { "name": "tv-tree-min-height", "category": "empty", "usage": "Min height for empty and loading states (60px)" },
    { "name": "tv-empty-zone-border", "category": "empty", "usage": "Empty tree drop zone border" },
    { "name": "tv-empty-zone-bg", "category": "empty", "usage": "Empty tree drop zone background" },
    { "name": "tv-empty-zone-radius", "category": "empty", "usage": "Empty tree drop zone border radius" },

    { "name": "tv-z-index-dropdown", "category": "z-index", "usage": "Context menu z-index (1000)" },
    { "name": "tv-z-index-ghost", "category": "z-index", "usage": "Drag ghost z-index (10000)" },
