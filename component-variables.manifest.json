  "componentVariables": [
    { "name": "tv-rem", "category": "sizing", "usage": "Base sizing unit for proportional scaling (default: 10px)" },

    { "name": "tv-spacing-xs", "category": "spacing", "usage": "Extra small spacing (2px)" },
    { "name": "tv-spacing-sm", "category": "spacing", "usage": "Small spacing (4px)" },
    { "name": "tv-spacing-md", "category": "spacing", "usage": "Medium spacing (8px)" },
    { "name": "tv-spacing-lg", "category": "spacing", "usage": "Large spacing (12px)" },
    { "name": "tv-spacing-xl", "category": "spacing", "usage": "Extra large spacing (16px)" },

    { "name": "tv-font-size-xs", "category": "typography", "usage": "Extra small font (12px)" },
    { "name": "tv-font-size-sm", "category": "typography", "usage": "Small font (14px)" },
    { "name": "tv-font-size-base", "category": "typography", "usage": "Base font (16px)" },
    { "name": "tv-font-size", "category": "typography", "usage": "Default font size (= tv-font-size-sm)" },
    { "name": "tv-font-weight-medium", "category": "typography", "usage": "Medium font weight" },
    { "name": "tv-font-weight-semibold", "category": "typography", "usage": "Semibold font weight" },

    { "name": "tv-accent-color", "category": "color", "usage": "Primary accent color" },
    { "name": "tv-accent-color-hover", "category": "color", "usage": "Accent color on hover" },
    { "name": "tv-text-color", "category": "color", "usage": "Primary text color" },
    { "name": "tv-text-color-2", "category": "color", "usage": "Secondary/muted text color" },
    { "name": "tv-text-color-on-accent", "category": "color", "usage": "Text on accent backgrounds" },
    { "name": "tv-bg-color", "category": "surface", "usage": "Main background color" },
    { "name": "tv-border-color", "category": "border", "usage": "Default border color" },
    { "name": "tv-success-color", "category": "color", "usage": "Success/valid drop color" },
    { "name": "tv-danger-color", "category": "color", "usage": "Danger/invalid drop color" },
    { "name": "tv-light-bg", "category": "surface", "usage": "Elevated/subtle surface background" },
    { "name": "tv-hover-bg", "category": "surface", "usage": "Hover background" },
    { "name": "tv-active-bg", "category": "surface", "usage": "Active/pressed background" },
    { "name": "tv-selected-bg", "category": "surface", "usage": "Selected node background" },
    { "name": "tv-selected-border-color", "category": "border", "usage": "Selected node border color" },
