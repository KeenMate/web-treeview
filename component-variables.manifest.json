    { "name": "tv-drop-valid-border-color", "category": "dnd", "usage": "Valid drop target border color" },
    { "name": "tv-drop-invalid-bg", "category": "dnd", "usage": "Invalid drop target background" },
    { "name": "tv-drop-invalid-border-color", "category": "dnd", "usage": "Invalid drop target border color" },
    { "name": "tv-dragover-highlight-bg", "category": "dnd", "usage": "Dragover highlight background" },
