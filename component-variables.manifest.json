    { "name": "tv-border-width-base", "category": "border", "usage": "Base border width (1px)" },
    { "name": "tv-border", "category": "border", "usage": "Full border shorthand (1px solid border-color)" },
    { "name": "tv-node-bg-hover", "category": "surface", "usage": "Node hover background (aliases tv-hover-bg)" },
    { "name": "tv-node-bg-active", "category": "surface", "usage": "Node active/pressed background (aliases tv-active-bg)" },
    { "name": "tv-node-transition", "category": "tree", "usage": "Node content transition (set to 'none' to disable hover animation)" },

    { "name": "tv-border-radius-sm", "category": "border", "usage": "Small border radius (4px)" },
    { "name": "tv-border-radius-md", "category": "border", "usage": "Medium border radius (6px)" },
    { "name": "tv-border-radius-lg", "category": "border", "usage": "Large border radius (8px)" },

    { "name": "tv-transition-speed", "category": "animation", "usage": "Fast transition duration (150ms)" },
    { "name": "tv-transition-normal", "category": "animation", "usage": "Normal transition duration (200ms)" },
    { "name": "tv-easing", "category": "animation", "usage": "Default easing curve" },

    { "name": "tv-column-width", "category": "tree", "usage": "Unified column width for toggle, icon, and indent step (24px)" },
    { "name": "tv-indent-size", "category": "tree", "usage": "Tree node indent per level (= tv-column-width)" },
    { "name": "tv-node-padding", "category": "tree", "usage": "Node content padding" },
    { "name": "tv-node-height", "category": "tree", "usage": "Node row height (32px)" },
    { "name": "tv-icon-size", "category": "tree", "usage": "Node icon size (16px)" },
    { "name": "tv-toggle-size", "category": "tree", "usage": "Toggle icon column size (= tv-column-width)" },
    { "name": "tv-toggle-color", "category": "tree", "usage": "Toggle icon color" },

    { "name": "tv-glow-above-color", "category": "dnd", "usage": "Drop-above glow indicator color" },
    { "name": "tv-glow-below-color", "category": "dnd", "usage": "Drop-below glow indicator color" },
    { "name": "tv-glow-child-color", "category": "dnd", "usage": "Drop-as-child glow indicator color" },
    { "name": "tv-glow-above-bg", "category": "dnd", "usage": "Drop-above zone background" },
    { "name": "tv-glow-below-bg", "category": "dnd", "usage": "Drop-below zone background" },
    { "name": "tv-glow-child-bg", "category": "dnd", "usage": "Drop-as-child zone background" },
    { "name": "tv-glow-above-bg-active", "category": "dnd", "usage": "Drop-above zone active background" },
    { "name": "tv-glow-below-bg-active", "category": "dnd", "usage": "Drop-below zone active background" },
    { "name": "tv-glow-child-bg-active", "category": "dnd", "usage": "Drop-as-child zone active background" },
    { "name": "tv-glow-above-color-active", "category": "dnd", "usage": "Drop-above zone active text color" },
    { "name": "tv-glow-below-color-active", "category": "dnd", "usage": "Drop-below zone active text color" },
    { "name": "tv-glow-child-color-active", "category": "dnd", "usage": "Drop-as-child zone active text color" },
    { "name": "tv-glow-above-shadow", "category": "dnd", "usage": "Drop-above zone active box shadow" },
    { "name": "tv-glow-below-shadow", "category": "dnd", "usage": "Drop-below zone active box shadow" },
    { "name": "tv-glow-child-shadow", "category": "dnd", "usage": "Drop-as-child zone active box shadow" },
    { "name": "tv-glow-above-text", "category": "dnd", "usage": "Drop-above zone default text color" },
    { "name": "tv-glow-below-text", "category": "dnd", "usage": "Drop-below zone default text color" },
    { "name": "tv-glow-child-text", "category": "dnd", "usage": "Drop-as-child zone default text color" },
